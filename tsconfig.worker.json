{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "module": "es2022",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": []
  },
  // tests/worker/* exercise the route handlers with fake bindings, so they
  // type-check against the Workers types too (Node bits: node-shims.d.ts).
  "include": ["worker-configuration.d.ts", "src/**/*.ts", "src/**/*.d.ts", "tests/worker/**/*.ts"]
}

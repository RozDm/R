(http.request.uri.path.extension in {"php" "php3" "php4" "php5" "php7" "php8" "phps" "pht" "phtml" "phar" "inc"
 "asp" "aspx" "ashx" "asmx" "axd" "cfm" "jsp" "jspx" "jspa" "do" "action" "esp" "cgi" "pl" "py" "pyc" "rb" "sh" "exe"
 "dll" "env" "ini" "conf" "cfg" "config" "cnf" "properties" "yml" "yaml" "toml" "lock" "tfstate" "tfvars"
 "sql" "sqlite" "sqlite3" "db" "mdb" "dump" "bak" "backup" "old" "orig" "save" "swp" "tmp" "log" "tar" "gz" "tgz"
 "bz2" "xz" "zip" "rar" "7z" "war" "jar" "pem" "key" "crt" "p12" "pfx" "jks" "ppk" "kdbx" "ovpn"})
or (http.request.uri.path contains "/." and (not starts_with(http.request.uri.path, "/.well-known/")
 or http.request.uri.path wildcard "/.well-known*/.*"))
or http.request.uri.path wildcard "*.php/*"
or http.request.uri.path wildcard "*/wlwmanifest.xml"
or (not starts_with(http.request.uri.path, "/blogg/")
and not starts_with(http.request.uri.path, "/en/blog/")
and not starts_with(http.request.uri.path, "/api/views/")
and not starts_with(http.request.uri.path, "/_next/static/")
and (http.request.uri.path wildcard "*/wp-*"
or http.request.uri.path wildcard "*/wp/*"
or http.request.uri.path wildcard "*/wordpress*"
or http.request.uri.path wildcard "*/xmlrpc*"
or http.request.uri.path wildcard "*phpmyadmin*"
or http.request.uri.path wildcard "*/pma*"
or http.request.uri.path wildcard "*/myadmin*"
or http.request.uri.path wildcard "*/mysql*"
or http.request.uri.path wildcard "*/adminer*"
or http.request.uri.path wildcard "*/administrator*"
or http.request.uri.path wildcard "*/admin"
or http.request.uri.path wildcard "*/admin/*"
or http.request.uri.path wildcard "*/phpinfo*"
or http.request.uri.path wildcard "*/phpunit*"
or http.request.uri.path wildcard "*/vendor/*"
or http.request.uri.path wildcard "*/node_modules/*"
or http.request.uri.path wildcard "*/cgi-bin*"
or http.request.uri.path wildcard "*/actuator*"
or http.request.uri.path wildcard "*/solr*"
or http.request.uri.path wildcard "*/jenkins*"
or http.request.uri.path wildcard "*/struts*"
or http.request.uri.path wildcard "*/owa*"
or http.request.uri.path wildcard "*/ecp/*"
or http.request.uri.path wildcard "*/autodiscover*"
or http.request.uri.path wildcard "*/hnap1*"
or http.request.uri.path wildcard "*/boaform*"
or http.request.uri.path wildcard "*/gponform*"
or http.request.uri.path wildcard "*/server-status*"
or http.request.uri.path wildcard "*/server-info*"
or http.request.uri.path wildcard "*/_ignition*"
or http.request.uri.path wildcard "*/telescope*"
or http.request.uri.path wildcard "*manager/html*"
or http.request.uri.path wildcard "*-console*"
or http.request.uri.path wildcard "*/druid/*"
or http.request.uri.path wildcard "*/nacos*"
or http.request.uri.path wildcard "*/geoserver*"
or http.request.uri.path wildcard "*/+cscoe+*"
or http.request.uri.path wildcard "*/remote/*"
or http.request.uri.path wildcard "*/_vti_*"
or http.request.uri.path wildcard "*-inf/*"
or http.request.uri.path wildcard "*/swagger*"
or http.request.uri.path wildcard "*/api-docs*"
or http.request.uri.path wildcard "*/fckeditor*"
or http.request.uri.path wildcard "*/ckeditor*"
or http.request.uri.path wildcard "*/elfinder*"
or http.request.uri.path wildcard "*/tiny*mce*"
or http.request.uri.path wildcard "*/composer.*"
or http.request.uri.path wildcard "*/package*.json"
or http.request.uri.path wildcard "*/config.js*"
or http.request.uri.path wildcard "*/sftp-config*"
or http.request.uri.path wildcard "*/appsettings*"
or http.request.uri.path wildcard "*/credentials*"
or http.request.uri.path wildcard "*/id_rsa*"
or http.request.uri.path wildcard "*/dockerfile*"
or http.request.uri.path wildcard "*/backup*"
or http.request.uri.path wildcard "*/shell"
or http.request.uri.path wildcard "*/etc/passwd*"))

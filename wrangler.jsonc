{
  "name": "d",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // The Worker runs only for /api/*. Every Worker invocation counts against
    // the free plan's 100k requests/day (past it, they get a 429); requests
    // the asset server answers are free, unlimited and keep working past it.
    // So pages and files — misses too: a miss gets the 404 page, never the
    // Worker — are asset-first, with their headers from public/_headers, the
    // hash CSP baked into each page at build (scripts/finalize-export.mjs)
    // and the redirects in out/_redirects. Keep the key: without it a browser
    // tab opening /api/status (a navigation) would get the 404 page instead
    // of the Worker, and misses would wake the Worker. The MTA-STS policy is
    // the Worker's too: it proxies Cloudflare's (src/routes/mta-sts.ts).
    "run_worker_first": ["/api/*", "/.well-known/mta-sts.txt"]
  },
  "kv_namespaces": [
    {
      "binding": "STATUS",
      "id": "18a8d7fb285e4cf6a48fb17d9bc9207d"
    }
  ],
  "d1_databases": [
    {
      "binding": "METRICS",
      "database_name": "rozsoshnykh-metrics-v2",
      // v2: the original database's storage object died on Cloudflare's side
      // (2026-07-03, internal error 7500 on every operation incl. Time Travel)
      // and its deleted entry still ghost-locks the old name.
      "database_id": "4f40b727-fe8f-4dbb-87ab-d6438dfda711"
    }
  ],
  // Time-series sink for view/geo events. Sampled, append-only, 100k data
  // points/day on Free (3 months' retention). D1 still holds the current
  // totals (cheap to read); AE keeps history so we can draw "visits over
  // time" graphs that D1 counters can't answer.
  //
  // Reading from AE needs an API token (Account Analytics:Read) and the
  // account id; both are runtime secrets, not in this file:
  //   wrangler secret put CF_ACCOUNT_ID
  //   wrangler secret put AE_API_TOKEN
  // The read route falls back to an empty time-series when either is unset,
  // so writes can start collecting before the read token exists.
  // Per-IP throttle for the public write endpoints (/api/visit, /api/views
  // POST, /api/csp-report). Their header gates are spoofable, so a POST loop
  // could otherwise pollute the counters and burn D1's 100k writes/day —
  // which would take the contact form down with them. Limits are per
  // Cloudflare location; a real visitor sends a handful per session.
  "ratelimits": [
    { "name": "WRITE_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }
  ],
  "analytics_engine_datasets": [
    { "binding": "METRICS_AE", "dataset": "rozsoshnykh_metrics" }
  ],
  "triggers": {
    // */5 = health checks. 0 3 * * * = daily prune of the contact table at
    // 03:00 UTC (~04:00–05:00 Oslo, off-peak). Dispatch lives in scheduled()
    // — must update PRUNE_CRON in src/index.ts if this changes.
    "crons": ["*/5 * * * *", "0 3 * * *"]
  },
  "send_email": [
    {
      "name": "CONTACT_EMAIL",
      "destination_address": "d.rossoshnyh@gmail.com"
    }
  ],
  "routes": [
    { "pattern": "rozsoshnykh.no", "custom_domain": true },
    { "pattern": "www.rozsoshnykh.no", "custom_domain": true },
    // Serves only /.well-known/mta-sts.txt; the edge 301s the rest to the apex.
    { "pattern": "mta-sts.rozsoshnykh.no", "custom_domain": true }
  ],
  // Keep the workers.dev subdomain alive (wrangler disables it once routes
  // exist) so old links hit the Worker and get 301'd to the apex domain.
  "workers_dev": true,
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {}
  }
}
